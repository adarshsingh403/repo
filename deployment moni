DEPLOY MONITORING COMPONENTS IN OPENSHIFT:

Save final OpenShift YAML:

cat > demo-monitoring.yaml <<'EOF'

apiVersion: v1

kind: Namespace

metadata:

  name: demo-monitoring

---

apiVersion: v1

kind: ServiceAccount

metadata:

  name: kube-state-metrics

  namespace: demo-monitoring

---

apiVersion: v1

kind: ServiceAccount

metadata:

  name: prometheus

  namespace: demo-monitoring

---

apiVersion: v1

kind: Secret

metadata:

  name: thanos-objstore-config

  namespace: demo-monitoring

type: Opaque

stringData:

  objstore.yml: |

    type: S3

    config:

      bucket: thanos-metrics

      endpoint: 10.150.210.109:9000

      insecure: true

      access_key: minioadmin

      secret_key: ABC@BANK#2026

---

apiVersion: rbac.authorization.k8s.io/v1

kind: ClusterRole

metadata:

  name: demo-monitoring-kube-state-metrics

rules:

  - apiGroups: [""]

    resources:

      - configmaps

      - secrets

      - nodes

      - pods

      - services

      - resourcequotas

      - replicationcontrollers

      - limitranges

      - persistentvolumeclaims

      - persistentvolumes

      - namespaces

      - endpoints

    verbs: ["list", "watch"]

  - apiGroups: ["apps"]

    resources:

      - statefulsets

      - daemonsets

      - deployments

      - replicasets

    verbs: ["list", "watch"]

  - apiGroups: ["batch"]

    resources:

      - cronjobs

      - jobs

    verbs: ["list", "watch"]

  - apiGroups: ["autoscaling"]

    resources:

      - horizontalpodautoscalers

    verbs: ["list", "watch"]

  - apiGroups: ["networking.k8s.io"]

    resources:

      - ingresses

      - networkpolicies

    verbs: ["list", "watch"]

  - apiGroups: ["policy"]

    resources:

      - poddisruptionbudgets

    verbs: ["list", "watch"]

  - apiGroups: ["storage.k8s.io"]

    resources:

      - storageclasses

      - volumeattachments

    verbs: ["list", "watch"]

  - apiGroups: ["admissionregistration.k8s.io"]

    resources:

      - mutatingwebhookconfigurations

      - validatingwebhookconfigurations

    verbs: ["list", "watch"]

  - apiGroups: ["coordination.k8s.io"]

    resources:

      - leases

    verbs: ["list", "watch"]

  - apiGroups: ["certificates.k8s.io"]

    resources:

      - certificatesigningrequests

    verbs: ["list", "watch"]

---

apiVersion: rbac.authorization.k8s.io/v1

kind: ClusterRoleBinding

metadata:

  name: demo-monitoring-kube-state-metrics

roleRef:

  apiGroup: rbac.authorization.k8s.io

  kind: ClusterRole

  name: demo-monitoring-kube-state-metrics

subjects:

  - kind: ServiceAccount

    name: kube-state-metrics

    namespace: demo-monitoring

---

apiVersion: rbac.authorization.k8s.io/v1

kind: ClusterRole

metadata:

  name: demo-monitoring-prometheus

rules:

  - apiGroups: [""]

    resources:

      - nodes

      - nodes/metrics

      - services

      - endpoints

      - pods

      - namespaces

    verbs: ["get", "list", "watch"]

  - nonResourceURLs: ["/metrics"]

    verbs: ["get"]

---

apiVersion: rbac.authorization.k8s.io/v1

kind: ClusterRoleBinding

metadata:

  name: demo-monitoring-prometheus

roleRef:

  apiGroup: rbac.authorization.k8s.io

  kind: ClusterRole

  name: demo-monitoring-prometheus

subjects:

  - kind: ServiceAccount

    name: prometheus

    namespace: demo-monitoring

---

apiVersion: apps/v1

kind: Deployment

metadata:

  name: kube-state-metrics

  namespace: demo-monitoring

  labels:

    app: kube-state-metrics

spec:

  replicas: 1

  selector:

    matchLabels:

      app: kube-state-metrics

  template:

    metadata:

      labels:

        app: kube-state-metrics

    spec:

      serviceAccountName: kube-state-metrics

      containers:

        - name: kube-state-metrics

          image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.13.0

          args:

            - --port=8080

          ports:

            - name: http-metrics

              containerPort: 8080

          readinessProbe:

            httpGet:

              path: /metrics

              port: http-metrics

            initialDelaySeconds: 5

            timeoutSeconds: 5

          livenessProbe:

            httpGet:

              path: /metrics

              port: http-metrics

            initialDelaySeconds: 15

            timeoutSeconds: 5

---

apiVersion: v1

kind: Service

metadata:

  name: kube-state-metrics

  namespace: demo-monitoring

  labels:

    app: kube-state-metrics

spec:

  selector:

    app: kube-state-metrics

  ports:

    - name: http-metrics

      port: 8080

      targetPort: http-metrics

---

apiVersion: v1

kind: ConfigMap

metadata:

  name: prometheus-config

  namespace: demo-monitoring

data:

  prometheus.yml: |

    global:

      scrape_interval: 30s

      evaluation_interval: 30s

      external_labels:

        cluster: demo-cluster

    scrape_configs:

      - job_name: 'kube-state-metrics'

        static_configs:

          - targets:

              - kube-state-metrics.demo-monitoring.svc:8080

        metric_relabel_configs:

          - source_labels: [__name__]

            regex: 'kube_node_status_condition|kube_pod_status_phase|kube_pod_status_ready|kube_pod_container_status_restarts_total|kube_pod_container_status_waiting_reason|kube_deployment_spec_replicas|kube_deployment_status_replicas_available|kube_statefulset_status_replicas_ready|kube_daemonset_status_number_ready|kube_job_status_failed'

            action: keep

---

apiVersion: apps/v1

kind: Deployment

metadata:

  name: prometheus-thanos

  namespace: demo-monitoring

  labels:

    app: prometheus-thanos

spec:

  replicas: 1

  selector:

    matchLabels:

      app: prometheus-thanos

  template:

    metadata:

      labels:

        app: prometheus-thanos

    spec:

      serviceAccountName: prometheus

      securityContext:

        seccompProfile:

          type: RuntimeDefault

      containers:

        - name: prometheus

          image: quay.io/prometheus/prometheus:v2.54.1

          args:

            - --config.file=/etc/prometheus/prometheus.yml

            - --storage.tsdb.path=/prometheus/data

            - --storage.tsdb.min-block-duration=2h

            - --storage.tsdb.max-block-duration=2h

            - --web.enable-lifecycle

          ports:

            - name: http

              containerPort: 9090

          securityContext:

            allowPrivilegeEscalation: false

            runAsNonRoot: true

            capabilities:

              drop:

                - ALL

          volumeMounts:

            - name: config

              mountPath: /etc/prometheus

            - name: data

              mountPath: /prometheus

        - name: thanos-sidecar

          image: quay.io/thanos/thanos:v0.36.1

          args:

            - sidecar

            - --tsdb.path=/prometheus/data

            - --prometheus.url=http://localhost:9090

            - --objstore.config-file=/etc/thanos/objstore.yml

            - --grpc-address=0.0.0.0:10901

            - --http-address=0.0.0.0:10902

          ports:

            - name: grpc

              containerPort: 10901

            - name: http-sidecar

              containerPort: 10902

          securityContext:

            allowPrivilegeEscalation: false

            runAsNonRoot: true

            capabilities:

              drop:

                - ALL

          volumeMounts:

            - name: data

              mountPath: /prometheus

            - name: objstore-config

              mountPath: /etc/thanos

      volumes:

        - name: config

          configMap:

            name: prometheus-config

        - name: objstore-config

          secret:

            secretName: thanos-objstore-config

        - name: data

          emptyDir: {}

---

apiVersion: v1

kind: Service

metadata:

  name: prometheus-thanos

  namespace: demo-monitoring

  labels:

    app: prometheus-thanos

spec:

  selector:

    app: prometheus-thanos

  ports:

    - name: http

      port: 9090

      targetPort: http

    - name: grpc

      port: 10901

      targetPort: grpc

    - name: http-sidecar

      port: 10902

      targetPort: http-sidecar

---

apiVersion: v1

kind: Service

metadata:

  name: prometheus-thanos-nodeport

  namespace: demo-monitoring

spec:

  type: NodePort

  selector:

    app: prometheus-thanos

  ports:

    - name: grpc

      port: 10901

      targetPort: grpc

      nodePort: 30901

    - name: http-sidecar

      port: 10902

      targetPort: http-sidecar

      nodePort: 30902

    - name: http

      port: 9090

      targetPort: http

      nodePort: 30090

EOF

